rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Each user owns their own games subcollection: users/{uid}/games/{gameId}
    match /users/{userId}/games/{gameId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Saved player roster (name + photo), for autocomplete/personalization: users/{uid}/roster/{playerId}
    match /users/{userId}/roster/{playerId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Public, read-only, no-account-needed game recap links: /share/[id].
    // Anyone can read a share once its id is known; only a signed-in user
    // can publish one, and shares are immutable once created.
    match /public_shares/{shareId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update, delete: if false;
    }
  }
}
